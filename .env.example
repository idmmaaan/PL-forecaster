# Copy to .env and adjust. Never commit the real .env or a provider token.

# Application environment
APP_ENV=development

# Database. Matches infra/compose.yaml; start it with `make db-up`.
DATABASE_URL=postgresql+psycopg://epl:epl@localhost:5432/epl_predictor

# Upcoming fixtures come from football-data.org. Register for a free key at
# https://www.football-data.org/client/register - only needed for `make sync-fixtures`.
FOOTBALL_DATA_API_TOKEN=replace_me_with_actual_token
FOOTBALL_DATA_BASE_URL=https://api.football-data.org/v4

# Where versioned model artifacts are read from. Relative paths resolve
# against the repository root.
MODEL_ARTIFACT_PATH=./ml/artifacts

# Browser origins allowed to call the API, comma-separated. The Vite dev server
# proxies /api by default, so this only matters when calling the API directly.
CORS_ALLOW_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
