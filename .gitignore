# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# C extensions
*.so

# Distribution / packaging
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
sdist/
wheels/
*.egg-info/
.installed.cfg
*.egg

# Virtual environments
.venv/
venv/
env/
ENV/

# Node.js
node_modules/
npm-debug.log
yarn-debug.log
yarn-error.log

# Vite build output
apps/web/dist/
.vite/

# IDE
.vscode/
.idea/
*.swp
*.swo

# macOS
.DS_Store
._*
.Spotlight-V100
.Trashes

# Windows
Thumbs.db
ehthumbs.db
desktop.ini

# ML data and artifacts are reproducible outputs, not source.
# Raw downloads are preserved on disk but never committed.
ml/data/raw/*
ml/data/interim/*
ml/data/processed/*
ml/artifacts/*
ml/reports/*
!ml/data/raw/.gitkeep
!ml/data/interim/.gitkeep
!ml/data/processed/.gitkeep
!ml/artifacts/.gitkeep
!ml/reports/.gitkeep

# Environment files: the template is committed, real secrets are not.
.env
.env.local
.env.*.local
!.env.example

# Logs
logs/
*.log

# Test and type-check caches
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
coverage.xml
*.cover
htmlcov/

# AutoGluon writes timestamped scratch directories when fitting candidates.
AutogluonModels/
